    {
      "name": "5. Orders & Out-of-Stock Prevention",
      "item": [
        {
          "name": "Place Order - SUCCESS (Items in Stock)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Order successfully created\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.orderNumber).to.be.a('string');",
                  "});",
                  "if (jsonData && jsonData.data) {",
                  "    pm.environment.set(\"orderId\", jsonData.data.id);",
                  "    pm.environment.set(\"orderNumber\", jsonData.data.orderNumber);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Customer {{$timestamp}}\",\n  \"customerEmail\": \"customer_{{$timestamp}}@example.com\",\n  \"items\": [\n    {\n      \"variantId\": {{variantId}},\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "description": "Places an order for an available variant. Stock is deducted automatically."
          },
          "response": []
        },
        {
          "name": "Place Order - REJECTED (Out of Stock Prevention)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409 Conflict (Overselling Prevented)\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Error response indicates OUT OF STOCK\", function () {",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "    pm.expect(jsonData.message).to.include(\"OUT OF STOCK\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Oversell Attempt\",\n  \"customerEmail\": \"oversell@example.com\",\n  \"items\": [\n    {\n      \"variantId\": {{outOfStockVariantId}},\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "description": "CRITICAL TEST: Demonstrates prevention of selling items that are out of stock. Variant {{outOfStockVariantId}} has 0 stock, so this request is rejected with HTTP 409 Conflict."
          },
          "response": []
        },
