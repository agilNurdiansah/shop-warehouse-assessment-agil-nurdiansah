    {
      "name": "5. Orders & Out-of-Stock Prevention",
      "item": [
        {
          "name": "Place Order - SUCCESS (Variant 1 in Stock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Alice Smith\",\n  \"customerEmail\": \"alice@example.com\",\n  \"items\": [\n    {\n      \"variantId\": 1,\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "description": "Places an order for variant 1 ('TSHIRT-BLK-M', stock: 50). Stock is deducted automatically."
          },
          "response": []
        },
        {
          "name": "Place Order - REJECTED (Out of Stock Prevention)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409 Conflict (Overselling Prevented)\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Error response indicates OUT OF STOCK\", function () {",
                  "    pm.expect(jsonData.status).to.eql('gagal');",
                  "    pm.expect(jsonData.code).to.eql(409);",
                  "    pm.expect(jsonData.message).to.include(\"OUT OF STOCK\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Bob Miller\",\n  \"customerEmail\": \"bob@example.com\",\n  \"items\": [\n    {\n      \"variantId\": 4,\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "description": "CRITICAL TEST: Variant 4 ('TSHIRT-WHT-XL') has 0 stock. This order is automatically rejected with HTTP 409 Conflict."
          },
          "response": []
        },
