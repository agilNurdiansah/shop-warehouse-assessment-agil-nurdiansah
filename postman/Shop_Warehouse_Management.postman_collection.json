  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as Tester (Auto Set Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Token received\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.accessToken).to.be.a('string');",
                  "});",
                  "if (jsonData && jsonData.data && jsonData.data.accessToken) {",
                  "    pm.environment.set(\"token\", jsonData.data.accessToken);",
                  "    console.log(\"Saved JWT Token to environment: \" + jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testerUsername}}\",\n  \"password\": \"{{testerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates as the test admin user ('tester' / 'tester123') and automatically stores the Bearer JWT token into the environment variable {{token}}."
          },
          "response": []
        },
